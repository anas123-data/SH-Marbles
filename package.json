{
  "name": "sh-marbles",
  "version": "0.5.0",
  "private": true,
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "qa:homepage": "node scripts/qa-homepage.cjs",
    "qa:catalogue": "node scripts/qa-catalogue.cjs",
    "qa:lighthouse": "lighthouse http://127.0.0.1:3000 --quiet --chrome-flags=--headless --output=html --output=json --output-path=output/phase-5/lighthouse-mobile",
    "test:bespoke": "node --test --test-isolation=none scripts/bespoke.test.mjs",
    "qa:bespoke": "node scripts/qa-bespoke.cjs",
    "qa:studio": "node scripts/qa-studio.cjs",
    "test:concierge": "node --test --test-isolation=none scripts/concierge.test.mjs",
    "qa:concierge": "node scripts/qa-concierge.cjs",
    "test:seo": "node --test --test-isolation=none scripts/seo.test.mjs",
    "qa:seo": "node scripts/qa-seo.cjs"
  },
  "dependencies": {
    "next": "16.4.0",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "24.0.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "lighthouse": "13.5.0",
    "playwright": "1.64.0",
    "postcss": "8.5.29",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2"
  },
  "packageManager": "pnpm@11.25.0"
}
